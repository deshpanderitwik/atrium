	<string>Atrium uses local network to receive hot-reload updates from InjectionIII during development.</string>
	<key>UIAppFonts</key>
	<array>
		<string>EBGaramond-Regular.ttf</string>
		<string>EBGaramond-Medium.ttf</string>
		<string>EBGaramond-Italic.ttf</string>
		<string>EBGaramond-MediumItalic.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
